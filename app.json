{
  "expo": {
    "name": "PokéLoot",
    "slug": "pokeloot",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1b1f2a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.comsud.pokelootborn",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#1b1f2a",
    "plugins": [
      "./plugins/withNoForceDark",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Nunito",
                "fontDefinitions": [
                { "path": "./assets/fonts/Nunito_400Regular.ttf", "weight": 400 },
                { "path": "./assets/fonts/Nunito_600SemiBold.ttf", "weight": 600 },
                { "path": "./assets/fonts/Nunito_700Bold.ttf", "weight": 700 },
                { "path": "./assets/fonts/Nunito_800ExtraBold.ttf", "weight": 800 },
                { "path": "./assets/fonts/Nunito_900Black.ttf", "weight": 900 }
                ]
              }
            ]
          }
        }
      ]
    ],
    "owner": "azhaq47",
    "extra": {
      "eas": {
        "projectId": "f153915a-70e5-4563-827b-88bcd42bdc8a"
      }
    }
  }
}
